     RowBox[{"ContourStyle", " ", "\[Rule]", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", 
        RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
        RowBox[{"ColorData", "[", 
         RowBox[{"1", ",", "2"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sp", " ", "=", " ", 
   RowBox[{"StreamPlot", "[", 
    RowBox[{"field", ",", " ", 
