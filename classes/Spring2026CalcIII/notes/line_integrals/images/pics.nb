Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"electricField", "[", 
     RowBox[{"{", 
      RowBox[{"q_", ",", 
       RowBox[{"r0", ":", 
        RowBox[{"{", 
         RowBox[{"x0_", ",", "y0_"}], "}"}]}]}], "}"}], "]"}], "[", 
    RowBox[{"r", ":", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", "=", 
       RowBox[{"r", "-", "r0"}]}], "}"}], ",", 
     RowBox[{"q", "*", 
      RowBox[{"v", "/", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"v", ".", "v"}], ")"}], 
        RowBox[{"3", "/", "2"}]]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q2", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q3", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q4", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"charges", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"q1", ",", "q2", ",", "q3", ",", "q4"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"field", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"electricField", "[", "#", "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], "]"}], "&"}], " ", "/@", " ", 
      "charges"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"electricPotential", "[", 
     RowBox[{"{", 
      RowBox[{"q_", ",", 
       RowBox[{"r0", ":", 
        RowBox[{"{", 
         RowBox[{"x0_", ",", "y0_"}], "}"}]}]}], "}"}], "]"}], "[", 
    RowBox[{"r", ":", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}]}], "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", "=", 
       RowBox[{"r", "-", "r0"}]}], "}"}], ",", 
     RowBox[{"q", "/", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"v", ".", "v"}], ")"}], 
       RowBox[{"1", "/", "2"}]]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"potential", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"electricPotential", "[", "#", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], "]"}], "&"}], " ", "/@", " ", 
     "charges"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"point", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q_", ",", 
       RowBox[{"p", ":", 
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_"}], "}"}]}]}], "}"}], ",", " ", 
     RowBox[{"r_:", "0.1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "color", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"color", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"q", "<", "0"}], ",", "Red", ",", "Green"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Lighter", "@", "color"}], ",", 
          RowBox[{"Disk", "[", 
           RowBox[{"p", ",", 
            RowBox[{"r", "*", 
             RowBox[{"Abs", "[", "q", "]"}]}]}], "]"}]}], "}"}], ",", 
        RowBox[{"Circle", "[", 
         RowBox[{"p", ",", 
          RowBox[{"r", "*", 
           RowBox[{"Abs", "[", "q", "]"}]}]}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"cp", " ", "=", " ", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{"potential", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
