     RowBox[{"StreamPoints", " ", "\[Rule]", " ", "99"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"electro", " ", "=", " ", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
