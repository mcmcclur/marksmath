digraph smallNN {
    rankdir=LR; 
    node [shape=circle];
    edge [arrowsize=0.6]; 
    splines=true; 
    ranksep = 1.5;
    nodesep = 0.5;

    subgraph clusterinput {
        label="Input";
        color=none;
        x1 [label=<<i>x</i><sub>1</sub>>];
        x2 [label=<<i>x</i><sub>2</sub>>];
        x0 [label="1"];
    }

    subgraph clusterhidden {
        label="Hidden layer";
        color=none;
        a1 [label=<<i>h</i><sub>1</sub>>];
        a2 [label=<<i>h</i><sub>2</sub>>];
        a0 [label="1"];
    }

    subgraph clusteroutput {
        label = "Output"
        color = none;
        y [label=<<i>y</i><sub>1</sub>>]
    }


    x1 -> a1 [label=<<i>w</i><sub>0,1,1</sub>>];
    x2 -> a1;
    x0 -> a1;
    x1 -> a2;
    x2 -> a2; 
    x0 -> a2 [label=<<i>w</i><sub>0,1,2</sub>>];
    a1 -> y [label=<<i>w</i><sub>1,1,3</sub>>];
    a2 -> y;
    a0 -> y [label=<<i>w</i><sub>1,0,3</sub>>];

    z [ label="Post-process" shape=none ]
    y -> z


}
