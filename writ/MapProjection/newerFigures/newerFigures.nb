Cell[BoxData[{
 RowBox[{
  RowBox[{"landData", " ", "=", " ", 
   RowBox[{"Import", "[", "\"\<ne_110m_land-geo.json\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"parallels", "=", 
   RowBox[{"Line", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lng", ",", "lat"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"lng", ",", 
          RowBox[{"-", "180"}], ",", "180", ",", "5"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"lat", ",", 
        RowBox[{"-", "85"}], ",", "85", ",", "10"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"meridians", "=", 
   RowBox[{"Line", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lng", ",", "lat"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"lat", ",", 
          RowBox[{"-", "85"}], ",", "85", ",", "5"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"lng", ",", 
        RowBox[{"-", "180"}], ",", "180", ",", "10"}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"land", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Polygon", "[", 
       RowBox[{"\"\<coordinates\>\"", " ", "/.", " ", "#"}], "]"}], "&"}], ",",
      " ", 
     RowBox[{"\"\<geometry\>\"", " ", "/.", " ", 
      RowBox[{"(", 
       RowBox[{"\"\<features\>\"", " ", "/.", " ", "landData"}], ")"}]}]}], 
    "]"}]}], ";"}]}], "Input",
