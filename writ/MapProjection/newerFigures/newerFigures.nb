Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"addZero", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1_", ",", "y1_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x2_", ",", "y2_"}], "}"}]}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1", ",", "y1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x2", "*", "y1"}], "-", 
           RowBox[{"x1", "*", "y2"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"y1", "-", "y2"}], ")"}]}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x2", ",", "y2"}], "}"}]}], "}"}], "/;", 
    RowBox[{
     RowBox[{"y1", "*", "y2"}], "<", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"addZero", "[", 
    RowBox[{"pair", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x1_", ",", "y1_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x2_", ",", "y2_"}], "}"}]}], "}"}]}], "]"}], ":=", 
   RowBox[{"pair", "/;", 
    RowBox[{
     RowBox[{"y1", "*", "y2"}], "\[GreaterEqual]", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"addZeros", "[", 
    RowBox[{"list", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"_", "?", "NumericQ"}], ",", 
         RowBox[{"_", "?", "NumericQ"}]}], "}"}], ".."}], "}"}]}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{"#", ",", 
         RowBox[{"-", "1"}]}], "]"}], "&"}], "/@", 
      RowBox[{"(", 
       RowBox[{"addZero", "/@", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"list", ",", 
            RowBox[{"First", "[", "list", "]"}]}], "]"}], ",", "2", ",", 
          "1"}], "]"}]}], ")"}]}], ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cmpNorth", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"land", "/.", 
        RowBox[{
         RowBox[{"Polygon", "[", "vv_", "]"}], "\[RuleDelayed]", 
         RowBox[{"Polygon", "[", 
          RowBox[{"addZeros", "/@", "vv"}], "]"}]}]}], ",", "meridians", ",", 
       "parallels"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"y_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
           RowBox[{"#", "<", "0"}]}], "&"}], ")"}]}]}], "}"}], ",", 
     "Infinity"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cmp", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.4", "]"}], ",", "meridians", ",", 
       "parallels"}], "}"}], ",", "land"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9851858206794653`*^9, 3.985185821074773*^9}, {
  3.985185973493438*^9, 3.985185981784338*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"df2f22be-05c6-4a67-bdb4-022c9c16ee5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"showProj", "[", 
   RowBox[{"T_", ",", 
    RowBox[{"north_", ":", "False"}]}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"P", ",", "P1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"lng_", "?", "NumericQ"}], ",", 
         RowBox[{"lat_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
      RowBox[{"T", "[", 
       RowBox[{"{", 
        RowBox[{"lat", ",", "lng"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"lng_", "?", "NumericQ"}], ",", 
         RowBox[{"lat_", "?", "NumericQ"}]}], "}"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"P1", "[", 
        RowBox[{"N", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lng", "*", "Degree"}], ",", 
           RowBox[{"lat", "*", "Degree"}]}], "}"}], "]"}], "]"}], "/", 
       "Degree"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P", "[", "list_List", "]"}], ":=", 
      RowBox[{"P", "/@", "list"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P", "[", 
       RowBox[{"Line", "[", "points_", "]"}], "]"}], ":=", 
      RowBox[{"Line", "[", 
       RowBox[{"P", "[", "points", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P", "[", 
       RowBox[{"Polygon", "[", "points_", "]"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.9", "]"}], ",", 
        RowBox[{"EdgeForm", "[", 
         RowBox[{"GrayLevel", "[", "0.4", "]"}], "]"}], ",", 
        RowBox[{"Polygon", "[", 
         RowBox[{"P", "[", "points", "]"}], "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P", "[", "x_", "]"}], ":=", "x"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"P", "[", "cmp", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Background", "\[Rule]", 
        RowBox[{"Lighter", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "\"\<Aquamarine\>\"", "]"}], "[", "1", 
           "]"}], ",", "0.5"}], "]"}]}]}], "]"}]}]}], "]"}]}], "\n", 
 RowBox[{"mPic", " ", "=", " ", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"showProj", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"Log", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Tan", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", 
           RowBox[{"Sec", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], "}"}], 
      "&"}], "]"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{"ImageSize", "\[Rule]", "450"}], ",", " ", 
    RowBox[{"Axes", " ", "->", " ", "False"}], ",", 
    RowBox[{"PlotRange", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "179"}], ",", "179"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "90"}], ",", "170"}], "}"}]}], "}"}]}]}], 
   "]"}]}]}], "Input",
