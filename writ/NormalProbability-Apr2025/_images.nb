Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"htPrimitive", "[", 
    RowBox[{"ht_", ",", 
     RowBox[{"{", "k_", "}"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"ht", "\[Equal]", "1"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Black", ",", " ", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "k"}], ",", "0"}], "}"}], ",", "0.75"}], "]"}], ",", 
       "White", ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"\"\<H\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "k"}], ",", "0"}], "}"}]}], "]"}], ",", 
         RowBox[{"FontSize", " ", "\[Rule]", " ", "22"}]}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EdgeForm", "[", "Black", "]"}], ",", "White", ",", " ", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "k"}], ",", "0"}], "}"}], ",", "0.75"}], "]"}], ",", 
       "Black", ",", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{"\"\<T\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "k"}], ",", "0"}], "}"}]}], "]"}], ",", 
         RowBox[{"FontSize", " ", "\[Rule]", " ", "22"}]}], "]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"htPic", "[", "tuple_", "]"}], " ", ":=", " ", 
  RowBox[{"Graphics", "[", 
   RowBox[{
    RowBox[{"MapIndexed", "[", 
     RowBox[{"htPrimitive", ",", "tuple"}], "]"}], ",", " ", 
