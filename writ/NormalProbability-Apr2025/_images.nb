  RowBox[{"c", " ", "=", " ", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"cuttoffs", " ", "=", " ", 
  RowBox[{"cuttoffs", "[", 
   RowBox[{"[", 
    RowBox[{"c", ";;"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"binValues", " ", "=", " ", 
  RowBox[{
   RowBox[{"binValues", "[", 
    RowBox[{"[", 
     RowBox[{"c", ";;"}], "]"}], "]"}], "/", 
   RowBox[{"Total", "[", 
    RowBox[{"binValues", "[", 
     RowBox[{"[", 
      RowBox[{"c", ";;"}], "]"}], "]"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.833290738862883*^9, 3.833290739279764*^9}, {
