a923a448e337"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", " ", "=", " ", "2.6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"m_", ",", "s_"}], "]"}], "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "m"}], ")"}], "2"]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        SuperscriptBox["s", "2"]}], ")"}]}], "]"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "Pi", " ", 
      SuperscriptBox["s", "2"]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"2", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "x0", ",", "4"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", "Thin", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "\[Rule]", "Axis"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"2", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Thickness", "[", "0.008", "]"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"pic1", " ", "=", " ", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2"}], "}"}], ",", " ", 
    RowBox[{"PlotRange", " ", "\[Rule]", " ", "All"}], ",", " ", 
    RowBox[{"AxesOrigin", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"Epilog", " ", "\[Rule]", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Darker", "[", 
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.368417", ",", "0.506779", ",", "0.709798"}], "]"}], "]"}],
        ",", " ", 
       RowBox[{"Line", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x0", ",", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"2", ",", 
               RowBox[{"1", "/", "2"}]}], "]"}], "[", "x0", "]"}]}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"x0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"MaTeX", "[", 
          RowBox[{
           RowBox[{"\"\<P\\\\approx\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"NIntegrate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"2", ",", 
                  RowBox[{"1", "/", "2"}]}], "]"}], "[", "x", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "x0", ",", "Infinity"}], "}"}], ",", " ", 
               RowBox[{"WorkingPrecision", "\[Rule]", "3"}]}], "]"}], "]"}]}],
            ",", " ", 
           RowBox[{"FontSize", " ", "\[Rule]", " ", "10"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"2.3", ",", "0.12"}], "}"}]}], "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"AspectRatio", " ", "\[Rule]", " ", 
     RowBox[{"1", "/", "2"}]}], ",", " ", 
    RowBox[{"ImageSize", " ", "\[Rule]", " ", "500"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
