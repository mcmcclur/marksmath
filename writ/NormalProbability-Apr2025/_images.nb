Cell[CellGroupData[{

Cell["Figure 5: Binomial distribution plots", "Subsection",
 CellChangeTimes->{{3.833231131771801*^9, 
  3.8332311446262093`*^9}},ExpressionUUID->"ef8d972c-00d8-4d1b-9cf9-\
43ccf4a70736"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pic5", " ", "=", " ", 
  RowBox[{"Grid", "[", 
   RowBox[{"Partition", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"n", "/", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"s", " ", "=", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "n", "]"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Plot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"x", "-", "m"}], ")"}], "2"]}], "/", 
                 RowBox[{"(", 
                  RowBox[{"2", 
                   SuperscriptBox["s", "2"]}], ")"}]}], "]"}], "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"2", "Pi", "*", 
                 SuperscriptBox["s", "2"]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "0", ",", "n"}], "}"}], ",", " ", 
              RowBox[{"PlotRange", " ", "\[Rule]", " ", "All"}]}], "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"DiscretePlot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Binomial", "[", 
                RowBox[{"n", ",", "k"}], "]"}], "/", 
               SuperscriptBox["2", "n"]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", " ", 
              RowBox[{"PlotMarkers", "->", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<\[CenterDot]\>\"", ",", " ", 
                 RowBox[{"FontSize", " ", "->", " ", "36"}]}], "]"}]}]}], 
             "]"}]}], "\[IndentingNewLine]", "}"}], ",", " ", 
          RowBox[{"PlotRange", " ", "\[Rule]", " ", "All"}], ",", " ", 
          RowBox[{"ImageSize", " ", "\[Rule]", " ", "250"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"{", 
          RowBox[{"5", ",", "10", ",", "20", ",", "50"}], "}"}]}], "}"}]}], 
      "]"}], ",", " ", "2"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.833231156944755*^9, 3.83323134301296*^9}, {
  3.8332313790869923`*^9, 3.833231478471611*^9}, {3.833231569776383*^9, 
