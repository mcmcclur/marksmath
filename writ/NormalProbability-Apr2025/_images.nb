Cell[BoxData[
 RowBox[{"Clear", "[", "m", "]"}]], "Input",
 CellChangeTimes->{{3.833313743599572*^9, 3.83331374494538*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"711cf4c4-7b82-43be-b5ba-c8c7eabdd21b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", 
    RowBox[{"m_", ",", "a_", ",", "k_"}], "]"}], "[", "x_", "]"}], " ", "=", 
  " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", "/", "k"}], ")"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"k", "/", 
      RowBox[{"(", 
       RowBox[{"k", "+", "x", "-", "m"}], ")"}]}], ")"}], 
    RowBox[{"a", "+", "1"}]]}]}]], "Input",
 CellChangeTimes->{{3.833024268187462*^9, 3.833024339859109*^9}, {
  3.833024532402997*^9, 3.833024534826035*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"46b6ab69-172b-43ff-a3be-afca15833d11"],

Cell[BoxData[
 FractionBox[
  RowBox[{"a", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["k", 
      RowBox[{
       RowBox[{"-", "50000"}], "+", "k", "+", "x"}]], ")"}], 
    RowBox[{"1", "+", "a"}]]}], "k"]], "Output",
 CellChangeTimes->{3.833024340667448*^9, 3.833024536176265*^9, 
  3.833089866958473*^9, 3.8330925219293756`*^9, 3.833095080120865*^9, 
